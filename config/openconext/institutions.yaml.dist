parameters:
  # The institution configuration for the Azure MFA GSSP
  institution_configuration: # Configuration identifier
    data: # The root node
      institutions:

        # Configuration for the OpenConext-devconf stepup environment. This makes AzureMFA use an EntraID mock IdP
        # hosed by OpenConext-devssp (https://ssp.dev.openconext.local/entra-mock/saml2/idp/metadata.php)
        # All devssp test accounts have an email address in the dev.openconext.local domain:
        # E.g. "jane-a1" has email "jane+jane-a1@dev.openconext.local".
        # So all AzureMFA registrations and authentications from the devconf environment match this configuration entry
        # in institutions.yaml.
        dev.openconext.local:
          entity_id: 'https://ssp.dev.openconext.local/entra-mock/saml2/idp/metadata.php'
          sso_location: 'https://ssp.dev.openconext.local/entra-mock/module.php/saml/idp/singleSignOnService'
          certificates: # The stepup/ssp/entra-mock-idp.crt certificate in OpenConext-devconf
